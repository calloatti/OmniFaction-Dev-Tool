<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>OmniFaction</AssemblyName>
    <RootNamespace>Calloatti.OmniFaction</RootNamespace>
    <TimberbornPath>C:\Program Files (x86)\Steam\steamapps\common\timberborn_main\Timberborn_Data\Managed</TimberbornPath>
  </PropertyGroup>

  <Import Project="CommonModSettings.props" />

  <ItemGroup>
    <!--
      The Publicizer Unsafe strategy turns each field-like event's compiler-generated backing
      field into a public field that shares the event's name, which makes event subscription
      syntax ambiguous (CS0229). Publicizer's documented fix is to exclude just those backing
      fields from publicization, while the events themselves stay public. The events below are
      the ones OmniFactionService subscribes to (publicized assemblies only; the
      unpublicized Contaminable/BlockableObject events are unaffected).
    -->
    <DoNotPublicize Include="Timberborn.GameDistricts:Timberborn.GameDistricts.Citizen.ChangedAssignedDistrict" />
    <DoNotPublicize Include="Timberborn.GameDistricts:Timberborn.GameDistricts.DistrictBuilding.ReassignedDistrict" />
    <DoNotPublicize Include="Timberborn.DwellingSystem:Timberborn.DwellingSystem.Dwelling.NumberOfDwellersChanged" />
    <DoNotPublicize Include="Timberborn.WorkSystem:Timberborn.WorkSystem.WorkRefuser.RefusesWorkChanged" />
    <DoNotPublicize Include="Timberborn.WorkSystem:Timberborn.WorkSystem.Workplace.WorkerAssigned" />
    <DoNotPublicize Include="Timberborn.WorkSystem:Timberborn.WorkSystem.Workplace.WorkerUnassigned" />
    <DoNotPublicize Include="Timberborn.WorkSystem:Timberborn.WorkSystem.Workplace.DesiredWorkersChanged" />
    <DoNotPublicize Include="Timberborn.WorkSystem:Timberborn.WorkSystem.WorkplaceWorkerType.WorkerTypeChanged" />
    <DoNotPublicize Include="Timberborn.BlockingSystem:Timberborn.BlockingSystem.BlockableObject.ObjectBlocked" />
    <DoNotPublicize Include="Timberborn.BlockingSystem:Timberborn.BlockingSystem.BlockableObject.ObjectUnblocked" />
  </ItemGroup>

</Project>

